@page
@model IndexModel
@{
    ViewData["Title"] = "Pegasus - Sistema de Gestión Escolar";
}

<div class="hero-section text-center py-1">
    <div class="container-fluid">
        <img src="~/img/pegasus.png" alt="Pegasus" class="mb-1" style="max-width: 120px;">
        <h1 class="display-4 mb-2">Pegasus</h1>
        <p class="lead mb-1">Sistema Integral de Gestión Escolar</p>
        <p class="text-muted">Digitaliza y optimiza los procesos educativos de tu institución</p>
    </div>
</div>

<div class="features-section py-2 bg-light">
    <div class="container-fluid px-4">
        <div class="row justify-content-center">
            <div class="col-12 text-center mb-2">
                <h2 class="display-7 mb-1">Funcionalidades Principales</h2>
                <p class="lead text-muted">Todo lo que necesitas para gestionar tu institución educativa</p>
            </div>
        </div>

        <div class="row text-center g-4">
            <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                <div class="feature-card h-100 p-2">
                    <i class="fas fa-graduation-cap fa-3x text-primary mb-3"></i>
                    <h5>Gestión Académica</h5>
                    <p class="text-muted">Calificaciones, asistencia y reportes académicos completos</p>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                <div class="feature-card h-100 p-2">
                    <i class="fas fa-users fa-3x text-primary mb-3"></i>
                    <h5>Comunicación</h5>
                    <p class="text-muted">Cuaderno digital y sistema de comunicados institucionales</p>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                <div class="feature-card h-100 p-2">
                    <i class="fas fa-calendar fa-3x text-primary mb-3"></i>
                    <h5>Eventos</h5>
                    <p class="text-muted">Calendario institucional y gestión de eventos escolares</p>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                <div class="feature-card h-100 p-2">
                    <i class="fas fa-chart-bar fa-3x text-primary mb-3"></i>
                    <h5>Reportes</h5>
                    <p class="text-muted">Informes detallados de rendimiento y asistencia</p>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                <div class="feature-card h-100 p-2">
                    <i class="fas fa-book fa-3x text-primary mb-3"></i>
                    <h5>Materias</h5>
                    <p class="text-muted">Administración completa de cursos y materias</p>
                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                <div class="feature-card h-100 p-2">
                    <i class="fas fa-user-shield fa-3x text-primary mb-3"></i>
                    <h5>Usuarios</h5>
                    <p class="text-muted">Gestión de perfiles: docentes, alumnos y padres</p>
                </div>
            </div>
        </div>
    </div>
</div>

