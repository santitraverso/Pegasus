@page
@using PegasusWeb.Entities
@model PegasusWeb.Pages.ConfirmarAsistenciaModel
@{
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Confirmar Asistencia</title>
</head>
<body>
    <h4>Confirmar Asistencia</h4>
    <hr />
    <form method="post" onsubmit="handleSubmit(event)" id="form">
        <input type="hidden" name="evento" asp-for="@Model.Evento.Id" />
        <input type="hidden" name="usuario" value="@Model.IdUsuario" />
        <input type="hidden" name="perfil" value="@Model.IdPerfil" />
        <input type="hidden" id="atras" name="atras" value="false">
        <button type="button" class="btn btn-primary btn-custom" onclick="atrasBoton()">Atras</button>
    </form>

    @if(Model.Evento != null && Model.Integrante != null)
    {
        <div class="evento-container" style="display: flex; justify-content: center; padding: 10px;">
            <div class="card6 card6-custom" style="max-width: 350px; width: 100%; display: flex; flex-direction: column; min-height: 400px;">

                <div style="text-align: center; flex-grow: 1; display: flex; flex-direction: column; justify-content: center; padding: 30px 20px;">
                    <h4 class="card-title" style="margin-bottom: 15px;">@(Model.Evento.Fecha.ToShortDateString())</h4>
                    <h5 class="card-title" style="margin-bottom: 15px;">@Model.Evento.Nombre</h5>
                    <p class="card-text" style="margin-bottom: 0;">@Model.Evento.Descripcion</p>
                    <p class="card-text @(Model.Confirmacion ? "success" : "warning")" style="margin-bottom: 0;">@(Model.Confirmacion ? "Ya has confirmado tu asistencia." : "No has confirmado tu asistencia.")</p>
                </div>

                <div style="padding: 20px; border-top: 1px solid #eee; margin-top: auto;">
                    <form method="post">
                        <input type="hidden" name="evento" value="@Model.Evento.Id" />
                        <input type="hidden" name="usuario" value="@Model.IdUsuario" />
                        <input type="hidden" name="perfil" value="@Model.IdPerfil" />
                        <input type="hidden" name="id" value="@Model.Integrante.Id" />
                        <input type="hidden" id="confirmar-@Model.Evento.Id" name="confirmar" value="false">

                        <div class="action-button confirm" onclick="confirmAsistencia(@Model.Evento.Id)">
                            <img src="~/img/asistenciaCheck.png" alt="confirmar" style="padding-right: 10px; width: 30px; height: 24px;" />
                            <span>Confirmar Asistencia</span>
                        </div>

                        <div class="action-button decline" onclick="submitForm(@Model.Evento.Id)">
                            <img src="~/img/quitar.png" class="edit-image" alt="quitar" style="padding-right: 10px; width: 30px; height: 24px;" />
                            <span>No Asistir</span>
                        </div>

                        <input type="submit" id="submit-@Model.Evento.Id" style="display:none" />
                    </form>
                </div>
            </div>
        </div>
    }
</body>
</html>
@section scripts{
    <script>
        function submitForm(id) {
            document.getElementById('submit-' + id).click();
        }

        function confirmAsistencia(id) {
            document.getElementById('confirmar-' + id).value = true;
            submitForm(id);
        }

        function atrasBoton() {
            document.getElementById('atras').value = true;
            document.getElementById('form').submit();
        }
    </script>
}
