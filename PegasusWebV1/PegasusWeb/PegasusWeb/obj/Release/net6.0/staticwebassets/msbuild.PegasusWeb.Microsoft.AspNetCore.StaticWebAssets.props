      <OriginalItemSpec>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\staticwebassets\PegasusWeb.bundle.scp.css))</OriginalItemSpec>
    </StaticWebAsset>
  </ItemGroup>
</Project>